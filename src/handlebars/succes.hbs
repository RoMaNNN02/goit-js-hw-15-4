<div class="country-card">
  <img
    src="{{flags}}"
    alt="{{name.official}}"
    class="country-flag"
    width="50"
  />
  <h1 class="country-name">
    {{name.official}}
  </h1>
  <ul class="country-info">
    <li>Столиця: {{capital}}</li>
    <li>Населення: {{population}} чел.</li>
    <li>Мови:{{language}}</li>
  </ul>
</div>